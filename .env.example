# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# ---------- WhatsApp Cloud API ----------
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=a_random_string_you_choose
WHATSAPP_TEMPLATE_LANGUAGE=en

# Names of approved Meta message templates
WHATSAPP_TEMPLATE_NAME=astrolamps_order_confirmation
WHATSAPP_FULFILLMENT_TEMPLATE_NAME=order_dispatched

# Optional: alternate template sent when the customer chose Bank Deposit at
# Shopify checkout. Leave blank to fall back to WHATSAPP_TEMPLATE_NAME for all
# orders regardless of payment method.
WHATSAPP_BANK_DEPOSIT_TEMPLATE_NAME=astrolamps_bank_deposit

# Optional: your actual bank account details. Used in the inbox copy of the
# bank-deposit message so the merchant sees the same thing the customer sees.
# Use \n for line breaks. The DOUBLE QUOTES around the value are REQUIRED
# whenever the text contains '#' — without quotes python-dotenv treats '#'
# as the start of a comment and silently truncates the value.
BANK_DETAILS_TEXT="Account Title: AstroLamps\nAccount #: 0123456789\nBank: HBL"

# Optional: amount in Rs. to deduct from the order total when the customer
# chooses Bank Deposit at checkout. Encoded into the WhatsApp template's
# total variable so the customer sees the discount inline. Set to 0 or
# leave blank to disable.
BANK_DEPOSIT_DISCOUNT=200

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Frontend ----------
# After Netlify deploy, set this to your real Netlify URL (no trailing slash)
FRONTEND_URL=https://your-site.netlify.app
